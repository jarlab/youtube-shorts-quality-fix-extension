{
  "manifest_version": 3,
  "name": "YouTube Auto HD",
  "version": "0.1.0",
  "description": "Automatically prefer 1080p on YouTube and lower quality when playback repeatedly buffers.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
