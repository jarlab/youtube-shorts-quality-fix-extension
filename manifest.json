{
  "manifest_version": 3,
  "name": "YouTube Auto HD",
  "version": "0.1.0",
  "description": "Automatically prefer 1080p on YouTube Shorts and lower quality when playback repeatedly buffers.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
